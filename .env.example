# Copia in .env.local per lo sviluppo oppure in .env per Docker Compose.
# Genera un valore casuale con: openssl rand -base64 32
AUTH_SECRET=sostituisci-con-un-valore-casuale-lungo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_PATH=./data/pingpong.db

# Usate soltanto da npm run db:bootstrap o scripts/bootstrap-admin.mjs.
# Non sono credenziali predefinite e non vengono lette dal sito pubblico.
ADMIN_EMAIL=
ADMIN_PASSWORD=
